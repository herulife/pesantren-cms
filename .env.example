# Al-Maa environment template

APP_URL=http://localhost:8080
API_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DB_PATH=./alma.db

JWT_SECRET=change_me_to_a_long_random_secret
COOKIE_SECURE=false
DEV_MODE=false
ENVIRONMENT=development

GOOGLE_CLIENT_ID=your_google_client_id

# Gateway WA mandiri (whatsmeow) — tanpa pihak ketiga.
# Opsional: ubah lokasi file sesi (default: data/wagate/wa_session.db)
# WA_SESSION_PATH=data/wagate/wa_session.db
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_CHAT_IDS=123456789
TELEGRAM_WEBHOOK_SECRET=change_me_telegram_secret

GEMINI_API_KEY=your_gemini_api_key_here

