# Environment and secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db

# Node / Next.js
apps/frontend/node_modules/
apps/frontend/.next/
apps/frontend/tsconfig.tsbuildinfo
apps/frontend/lint_errors.txt
apps/frontend/ts_errors.txt

# Go build/cache artifacts
.gocache/
.gomodcache/
*.exe
*.test
*.out

# Logs and temp files
*.log
*.tmp
.tmp_*.log
apps/backend/internal/features/videos/test_output.txt
apps/backend/internal/features/videos/vet_output.txt

# Local databases and runtime files
*.db
*.db-shm
*.db-wal
*.db.backup

# User uploads
apps/backend/public/uploads/

# Bun legacy binary lockfile
raport/bun.lockb

# Uploaded files
data/uploads/
# pakai * di depan: pola lama `.bak-*` hanya cocok untuk file bernama
# `.bak-xxx` di awal, bukan `AGENTS.md.bak-xxx` -> 28 file tetap ter-track
*.bak-*
*.pre-*

# live data (jangan commit)
data/

# Backup archives (contain secrets/db)
backups/*.tar.gz
backups/*.db
backups/*.db.*
backups/*.gz

# DB backup sementara (autocommit)
*.db.bak.*

# Deploy env (secret)
deploy/*.txt
# backend_env_userdel.env memuat JWT_SECRET live; jangan pernah di-commit
deploy/*.env
